{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "TEST_DATABASE_ADMIN_URL",
    "DATABASE_URL",
    "DATABASE_OWNER_URL",
    "DATABASE_ADMIN_URL",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false
    }
  }
}
