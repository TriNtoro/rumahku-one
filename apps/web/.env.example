# Salin ke .env.local. JANGAN commit nilai asli.
DATABASE_URL=postgres://rumahku_app:CHANGE_ME@localhost:5432/rumahku
APP_URL=http://localhost:3000
CRON_SECRET=ganti-dengan-string-acak-minimal-32-karakter
LOG_LEVEL=info
# Penyimpanan S3-compatible (Cloudflare R2 / Supabase / MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
